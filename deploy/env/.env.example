# Lumo Base — SANITIZED environment example
# Copy to deploy/env/.env and fill every CHANGE_ME value before any phase is started.
# deploy/env/.env is gitignored. NEVER commit real secrets or paste them into logs/issues.
#
# Variable NAMES are taken verbatim from the official Supabase docker/.env.example
# at tag self-hosted/v0.8.4. A read-only copy of that file is kept at
# deploy/upstream/env.example.reference for verification. Do not invent names.
# Docs: https://supabase.com/docs/guides/self-hosting/docker
#       https://supabase.com/docs/guides/self-hosting/self-hosted-auth-keys
#
# Generate real values with the upstream helpers (available after sync-upstream.sh):
#   sh vendor/supabase-docker/utils/generate-keys.sh
#   sh vendor/supabase-docker/utils/add-new-auth-keys.sh
#   openssl rand -base64 48

# ---------------------------------------------------------------- wiring
# Base upstream compose first, then the Lumo Base override.
COMPOSE_FILE=docker-compose.yml:docker-compose.lumo.yml

# ---------------------------------------------------------------- postgres
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ---------------------------------------------------------------- legacy HS256
JWT_SECRET=CHANGE_ME_at_least_32_chars_generate_with_openssl_rand_base64_48
ANON_KEY=CHANGE_ME_generated_by_add_new_auth_keys_sh
SERVICE_ROLE_KEY=CHANGE_ME_generated_by_add_new_auth_keys_sh

# ---------------------------------------------------------------- new API keys / asymmetric JWT
# SUPABASE_PUBLISHABLE_KEY and SUPABASE_SECRET_KEY are API keys.
# JWT_KEYS / JWT_JWKS are JWT SIGNING material. Different lifecycles - do not conflate.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
# Pre-signed ES256 JWT "API keys" used internally by the gateway. Never use in client code.
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# ---------------------------------------------------------------- studio (private admin)
DASHBOARD_USERNAME=CHANGE_ME_admin_username
DASHBOARD_PASSWORD=CHANGE_ME_letters_and_digits_not_numbers_only
STUDIO_DEFAULT_ORGANIZATION=Lumo Base
STUDIO_DEFAULT_PROJECT=Internal
OPENAI_API_KEY=

# ---------------------------------------------------------------- service secrets
SECRET_KEY_BASE=CHANGE_ME_at_least_64_chars_openssl_rand_base64_48
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=CHANGE_ME_exactly_32_characters_here
PG_META_CRYPTO_KEY=CHANGE_ME_at_least_32_chars_openssl_rand_base64_24
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# ---------------------------------------------------------------- public URLs (behind Caddy TLS)
SUPABASE_PUBLIC_URL=https://your-domain.example.com
API_EXTERNAL_URL=https://your-domain.example.com/auth/v1
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# ---------------------------------------------------------------- auth
JWT_EXPIRY=3600
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=CHANGE_ME@example.com
SMTP_HOST=CHANGE_ME_smtp_host
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_SENDER_NAME=Lumo Base
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# ---------------------------------------------------------------- pooler (loopback only)
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=lumo-base
POOLER_DB_POOL_SIZE=5

# ---------------------------------------------------------------- storage (local filesystem backend)
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
# MinIO is deliberately NOT deployed on the single VPS.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------- postgREST
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# ---------------------------------------------------------------- gateway / TLS ingress
API_GW_HTTP_PORT=8000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
PROXY_DOMAIN=your-domain.example.com
CERTBOT_EMAIL=
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
IMGPROXY_AUTO_WEBP=false

# ---------------------------------------------------------------- deferred services (leave disabled)
FUNCTIONS_VERIFY_JWT=false
FUNCTIONS_MEMORY_LIMIT=2g
GOOGLE_PROJECT_ID=
GOOGLE_PROJECT_NUMBER=

# ---------------------------------------------------------------- backup destination (operator-supplied)
# Used by ops/backup/*.sh. Credentials must be injected at runtime, never stored here.
LUMO_BACKUP_DESTINATION=CHANGE_ME_external_destination_outside_the_vps
LUMO_BACKUP_ENCRYPTION_KEY=CHANGE_ME_age_or_gpg_recipient
